{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    { "kind": "folder", "path": "app/Sources/Folio", "target-membership": [ "Folio" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Folio.app", "id": "000000000000000000000120", "type": "wrapper.application", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "Folio",
      "id": "000000000000000100000000",
      "product": "Products/Folio.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "script",
          "name": "Build the Rust core and embed dylibs/resources",
          "run-on-every-build": true,
          "shell": "/bin/bash",
          "script": "exec /bin/bash \"$SRCROOT/scripts/xcode-embed.sh\"",
        },
      ],
      "build-settings": {
        "ARCHS": "arm64",
        "CODE_SIGN_INJECT_BASE_ENTITLEMENTS": "NO",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "8885WMRK5B",
        "ENABLE_APP_SANDBOX": "NO",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
        "GENERATE_INFOPLIST_FILE": "NO",
        "INFOPLIST_FILE": "$(SRCROOT)/app/Bundle/Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": "$(inherited) @executable_path/../Frameworks",
        "MACOSX_DEPLOYMENT_TARGET": "14.0",
        "MARKETING_VERSION": "1.2.0",
        "ONLY_ACTIVE_ARCH": "NO",
        "OTHER_CODE_SIGN_FLAGS": "--timestamp",
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.folio.reader",
        "PRODUCT_NAME": "Folio",
        "SDKROOT": "macosx",
        "SKIP_INSTALL": "NO",
        "SUPPORTED_PLATFORMS": "macosx",
        "SWIFT_VERSION": "5.0",
      },
    },
  ],
  "last-upgrade": "27.0",
  "last-swift-update": "27.0",
}
